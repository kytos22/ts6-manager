# syntax=docker/dockerfile:1.4
FROM node:22-slim AS base
ARG YT_DLP_VERSION=2026.08.20.234504
ARG YT_DLP_SHA256=8962aa45f945ae5aa11ab49acab365e8baef569ec995149f99ae0ae3a19cae93
RUN corepack enable && corepack prepare pnpm@9 --activate

# Install system deps and a pinned yt-dlp nightly that supports current YouTube clients.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      openssl \
      ffmpeg \
      python3 \
      ca-certificates \
      curl \
    && curl -fsSL \
      "https://github.com/yt-dlp/yt-dlp-nightly-builds/releases/download/${YT_DLP_VERSION}/yt-dlp" \
      -o /usr/local/bin/yt-dlp \
    && echo "${YT_DLP_SHA256}  /usr/local/bin/yt-dlp" | sha256sum -c - \
    && chmod 0755 /usr/local/bin/yt-dlp \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy everything at once to avoid BuildKit ordering bug on Windows
FROM base AS build
# Toolchain for the optional native Opus encoder. It exists only in the build
# stage; the production image receives the compiled module, not the compiler.
RUN apt-get update && \
    apt-get install -y --no-install-recommends build-essential && \
    apt-get clean && rm -rf /var/lib/apt/lists/*
COPY . .
RUN pnpm install --no-frozen-lockfile
RUN pnpm --filter @ts6/common run build
RUN pnpm --filter @ts6/backend exec prisma generate
RUN pnpm --filter @ts6/backend run build

# Production image
FROM base AS production
ENV NODE_ENV=production
WORKDIR /app

COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/pnpm-workspace.yaml ./pnpm-workspace.yaml
COPY --from=build /app/packages/common/dist ./packages/common/dist
COPY --from=build /app/packages/common/package.json ./packages/common/package.json
COPY --from=build /app/packages/backend/dist ./packages/backend/dist
COPY --from=build /app/packages/backend/generated ./packages/backend/generated
COPY --from=build /app/packages/backend/prisma ./packages/backend/prisma
COPY --from=build /app/packages/backend/package.json ./packages/backend/package.json
COPY --from=build /app/packages/backend/node_modules ./packages/backend/node_modules

WORKDIR /app/packages/backend
RUN mkdir -p data /data/music && \
    mkdir -p /root/.config/yt-dlp && \
    printf '%s\n' '--js-runtimes node' '--remote-components ejs:github' > /root/.config/yt-dlp/config

EXPOSE 3001
ENV SIDECAR_URL=http://ts6-sidecar:9800
CMD ["sh", "-c", "npx prisma db push --skip-generate && npx prisma db seed || true && node dist/index.js"]
